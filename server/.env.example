# Copy to server/.env and fill in what you have. Everything is optional: with nothing set,
# Ginn runs on a mock Telegram with the free offline parser.

# Who you are (used in messages)
GINN_MY_NAME=Sakib
GINN_MY_COMPANY=RocketX
GINN_EVENT=Daos Hub
GINN_TZ=Asia/Dubai

# Claude turns your sentence into follow-ups. Without it, a built-in rules parser does.
ANTHROPIC_API_KEY=
# GINN_MODEL=claude-opus-5-5

# Telegram user account: create an app at https://my.telegram.org (use a secondary account for demos)
TG_API_ID=
TG_API_HASH=

# Google Calendar: OAuth "Web application" client, redirect URI = <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the server is reachable (tunnel URL for a real G2 / phone), and seconds you get to undo
PUBLIC_URL=http://localhost:8787
# HOST=0.0.0.0
GINN_UNDO_SECONDS=20

# Local speech-to-text (whisper.cpp): brew install whisper-cpp, then download a model
# WHISPER_MODEL=~/.cache/whisper/ggml-small.en.bin
