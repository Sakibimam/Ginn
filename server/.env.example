# Copy to server/.env. Everything is optional: with nothing set, Ginn runs on a mock Telegram
# with the free offline parser, so you can try the whole flow first.

# ── Who you are (also editable on the setup page) ──
GINN_MY_NAME=
GINN_MY_COMPANY=
GINN_EVENT=
# GINN_TZ=Asia/Dubai            # defaults to this computer's time zone

# ── Parser: Claude turns your sentence into follow-ups. Without a key, a built-in rules parser does. ──
ANTHROPIC_API_KEY=
# GINN_MODEL=claude-opus-5-5

# ── Telegram user account: create an app at https://my.telegram.org (use a secondary account for demos) ──
TG_API_ID=
TG_API_HASH=

# ── Google Calendar: OAuth "Web application" client, redirect URI = <PUBLIC_URL>/auth/google/callback ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Network ──
PUBLIC_URL=http://localhost:8787   # your tunnel URL when using a real G2 or phone
# HOST=127.0.0.1                   # 0.0.0.0 to accept LAN connections (they need the pairing token)
# PORT=8787
# GINN_TRUST_LOCAL=true            # set false if a reverse proxy on this machine forwards outside traffic
# GINN_SECRET=                     # encrypts the Telegram session + Google tokens; default: data/secret.key

# ── Behaviour and limits ──
# GINN_UNDO_SECONDS=20             # how long every message waits so you can undo
# GINN_MAX_LISTEN_SECONDS=45       # longest debrief
# GINN_LITE_MAX_PER_HOUR=200       # Ginn Lite is public: total uses per hour
# GINN_LITE_PER_IP_PER_HOUR=20

# ── Speech to text (whisper.cpp: brew install whisper-cpp) ──
# WHISPER_MODEL=~/.cache/whisper/ggml-small.en.bin
# WHISPER_MODE=server              # keeps the model loaded (fast). "cli" runs whisper-cli per request.
# WHISPER_PORT=8178
# GINN_STT_CONCURRENCY=2           # parallel whisper-cli runs in cli mode
